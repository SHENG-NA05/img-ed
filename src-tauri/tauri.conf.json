{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photoshop Studio",
  "version": "1.0.0",
  "identifier": "com.photoshop.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Photoshop Studio - 專業影像編輯器",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "label": "main",
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
